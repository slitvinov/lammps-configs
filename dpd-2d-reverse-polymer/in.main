# DPD example
# Poiseuille flow with parameters from 
# J.Chem.Phys 132, 144103 (2010)
# DPD example
# 
# the simulation produces spatially averages 
# vy.av.dim{ndim} (velocity), rho.av.dim{ndim} (density),
# simtemp.av.dim${ndim} (temperature), sxy.av.dim${ndim} (shear
# stress)

# set simulation type
log             ${id}/log.lammps
include         in.generic
# lattice parameter
variable lsp    equal 1.0/${number_density}^(1.0/${ndim})

# temperature 
variable        kb equal 1.3806488e-23
variable        T equal 1.0/${kb}
# interaction parameters
variable        cutoff equal 1.0
variable        cutoff_cons equal 1.0
variable        m_power equal 0.25
variable        sigma equal 3.0
variable        gamma equal ${sigma}^2/(2*${T}*${kb})
variable        sigma delete
variable       adpd_ss    equal 25.0
variable       adpd_sp    equal 25.0
variable       adpd_pp    equal 25.0
variable       adpd_sw    equal 25.0
variable       adpd_pw    equal 25.0
variable       ntime    equal 200000
variable       savetime equal 1000
# FENE parameters
variable        r0 equal 1.0
variable        H equal 50

# number of timesteps
timestep	0.005
comm_modify vel yes cutoff 3.0
include ${simulationtype}/in.readatmos
include ${simulationtype}/in.setbonds

mass		* 1.0
velocity	all set 0 0 0
pair_style hybrid/overlay dpd/ext ${T} ${cutoff} ${dpdrandom} dpd ${T} ${cutoff} ${dpdrandom}

# s, p, w: solvent polymer wall
variable        s equal 1
variable        w equal 2
variable        p equal 3
pair_coeff * * dpd/ext 0.0 ${gamma} 0.0 ${m_power} ${m_power} ${cutoff}
pair_coeff * * dpd ${adpd_ss} 0.0 ${cutoff_cons}
pair_coeff ${s} ${w} dpd/ext 0.0 ${gamma} 0.0 ${m_power} ${m_power} ${cutoff}
pair_coeff ${s} ${w} dpd ${adpd_sw} 0.0 ${cutoff_cons}
pair_coeff ${w} ${p} dpd/ext 0.0 ${gamma} 0.0 ${m_power} ${m_power} ${cutoff}
pair_coeff ${w} ${p} dpd ${adpd_pw} 0.0 ${cutoff_cons}

neighbor	0.5 bin
neigh_modify    delay 0 every 1

include ${simulationtype}/in.createforce

# "profile" corrected temperature
compute         pTemp all temp/profile 1 1 0 y 5

# average velocity
variable vxav equal vcm(all,x)
variable  vx_cm atom vx-v_vxav
compute chunk_av_vx_running all chunk/atom bin/1d y center 0.01 units reduced
fix av_vx_running all ave/chunk 1 ${savetime} ${savetime} chunk_av_vx_running v_vx_cm file ${id}/vx.av.running ave running
compute chunk_av_vx_one all chunk/atom bin/1d y center 0.01 units reduced
fix av_vx_one all ave/chunk 1 ${savetime} ${savetime} chunk_av_vx_one v_vx_cm file ${id}/vx.av.one ave one

# stresses are in units of pressure*volume must be divided by per-atom
# volume to have units of stress (pressue); components of the stress
# are in the following order xx(1), yy(2), zz(3), xy(4), xz(5), yz(6)
# The {virial} keyword means include all terms except the kinetic energy {ke}.
compute stress all stress/atom NULL virial
variable pTemp4 equal c_pTemp[4]
variable stress_pressure atom (c_stress[4]-v_pTemp4/count(all))*${number_density}
compute chunk_av_xy_stress all chunk/atom bin/1d y lower 0.01 units reduced
fix av_xy_stress all ave/chunk 1 ${savetime} ${savetime} chunk_av_xy_stress v_stress_pressure file ${id}/sxy.av ave running

compute stress_bond all stress/atom NULL bond
variable vstress_bond atom c_stress_bond[4]*${number_density}
compute chunk_av_xy_bond all chunk/atom bin/1d y lower 0.01 units reduced
fix av_xy_bond all ave/chunk 1 ${savetime} ${savetime} chunk_av_xy_bond v_vstress_bond file ${id}/sxy-bond.av ave running

group polymer type 3
compute chunk_av_nd polymer chunk/atom bin/1d y lower 0.01 units reduced
fix av_nd polymer ave/chunk 1 ${savetime} ${savetime} chunk_av_nd density/number file ${id}/polymer.ndensyty ave running

include ${simulationtype}/in.setdump

include ${simulationtype}/in.run
