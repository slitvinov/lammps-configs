# DPD example (2D version)
# Poiseuille flow with parameters from 
# J.Chem.Phys 132, 144103 (2010)

# the simulation produces spatially averages 
# vy.av (velocity), rho.av (density), sxy.av (shear stress)
echo           both
variable       ndim equal 2
include        in.def

variable        xsize equal 20   # 50 p. 4
# use as a small number
variable        eps equal 1e-2*${xsize}
variable        ysize equal 50   # 20 p. 4
variable        gx equal 0.025 # from 0.025 to 0.25  (p.6)

# number of timesteps
variable        ntime equal 30000
timestep	0.005 # TODO:
atom_style	atomic

lattice         sq  ${lsp} origin 0.1 0.1 0.0

variable        Npart equal ${xsize}*${ysize}*${number_density}
print "Npart = ${Npart}"

region		box block 0 ${xsize} 0 ${ysize} -${eps} ${eps} units box
create_box	1 box
create_atoms	1 box

# TODO: find the way to generate the right number of atoms
# delete extra atoms
group extra_atoms id > ${Npart}
delete_atoms group extra_atoms
mass		1 ${pmass}

pair_style hybrid/overlay dpd/ext ${T} ${cutoff} 928948 dpd ${T} ${cutoff} 928948
pair_coeff * * dpd/ext 0.0 ${gamma} 0.0 ${m_power} ${m_power} ${cutoff}
pair_coeff * * dpd ${adpd} 0.0 ${cutoff_cons}

neighbor	0.5  bin
neigh_modify    delay 0 every 1

fix		1 all nve
# TOD: replace with several files
variable        Nfreq   equal  ${ntime}
variable        Nrepeat equal  round(0.9*${ntime})

# "profile" corrected temperature
compute         pTemp all temp/profile 1 1 0 y 5
compute chunk_av_vy all chunk/atom bin/1d y center 2.0
fix av_vy all ave/chunk 1 ${Nrepeat} ${Nfreq} chunk_av_vy vx file vx.av

# stresses are in units of pressure*volume must be divided by per-atom
# volume to have units of stress (pressue); components of the stress
# are in the following order xx(1), yy(2), zz(3), xy(4), xz(5), yz(6)
# The {virial} keyword means include all terms except the kinetic energy {ke}.
compute stress all stress/atom NULL virial
variable pTemp4 equal c_pTemp[4]
variable stress_pressure atom c_stress[4]-v_pTemp4/${Npart}
compute chunk_av_xy_stress all chunk/atom bin/1d x lower 2.0
fix av_xy_stress all ave/chunk 1 ${Nrepeat} ${Nfreq} chunk_av_xy_stress v_stress_pressure file sxy.av

variable bodyfx atom mass*${gx}*((y>${ysize}/2.0)-(y<${ysize}/2.0))
fix reverse_periodic all addforce v_bodyfx 0.0 0.0

#thermo          100
#dump myDump all image 1000 nb.*.jpg type type view 0 0
dump dDump all custom 1000 nb.*.dat xu yu vx vy
dump_modify	dDump pad 10

if "${ndim}==2" then "fix e2d all enforce2d"

run   ${ntime} every 1000 "velocity all zero linear"
run		${ntime} 
