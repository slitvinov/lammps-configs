# body force (units of acceleration)
variable gy equal 0.055
variable fy atom mass*${gy}*((x>${xsize}/2.0)-(x<${xsize}/2.0))
fix reverse_periodic all addforce 0.0 v_fy 0.0 
compute chunk_av_vy all chunk/atom bin/1d x center 0.2
fix av_vy all ave/chunk 1 ${Nrepeat} ${Nfreq} chunk_av_vy vy file vy.av.dim${ndim}
