region rvareg${crossid} block INF INF ${yposlo} ${yposhi} INF INF
compute chunk_av_vy${crossid} all chunk/atom bin/1d x center 0.2 units box region rvareg${crossid}
fix av_vy${crossid} all ave/chunk 1 ${Nrepeat} ${Nfreq} chunk_av_vy${crossid} vy file vy.av.${crossid}

compute chunk_av_stress${crossid} all chunk/atom bin/1d x center 0.2 units box region rvareg${crossid}

fix av_stress${crossid} all ave/chunk 1 ${Nrepeat} ${Nfreq} chunk_av_stress${crossid} v_stress_pressure file stress.av.${crossid}

compute chunk_av_stress_poly${crossid} all chunk/atom bin/1d x center 0.2 units box region rvareg${crossid}

fix av_stress_poly${crossid} all ave/chunk 1 ${Nrepeat} ${Nfreq} chunk_av_stress_poly${crossid} v_stress_pressure_poly file stress_poly.av.${crossid}

group  polymer_beads type 1
compute chunk_av_prho${crossid} polymer_beads chunk/atom bin/1d x center 0.2 units box region rvareg${crossid}
fix av_prho${crossid} polymer_beads ave/chunk 1 ${Nrepeat} ${Nfreq} chunk_av_prho${crossid} density/number file prho.av.${crossid}
compute chunk_av_rho${crossid} all chunk/atom bin/1d x center 0.2 units box region rvareg${crossid}
fix av_rho${crossid} all ave/chunk 1 ${Nrepeat} ${Nfreq} chunk_av_rho${crossid} density/number file rho.av.${crossid}

variable yposlo delete
variable yposhi delete
variable cross_id delete
