# move one atom with a constant acceleration
echo        both
variable    ndim index 2
variable    pmass index 0.25
atom_style  sph
include "in.minsetup"
comm_modify vel yes

variable        nu equal 1e-6
variable        cutoff equal 3.0
variable        gamma equal 1.0
variable        csound equal 10.0
variable        rho0 equal 1.0
create_atoms 1 single 4.5 5.0 0.0 units box
group        fst id == 1
velocity     fst set 1.0 0.0 0.0 units box

create_atoms 1 single 5.5 5.0 0.0 units box
group        snd id == 2
velocity     snd set 0.0 1.0 0.0 units box

create_atoms 1 single 5.6 5.1 0.0 units box
group        thd id == 3
velocity     thd set 0.5 0.1 0.0 units box



fix mp all property/atom rmass d2_cg 3 ghost yes
set type 1 mass ${pmass}
compute rhoatom all sph/rho/atom
variable rhoat atom c_rhoatom
pair_style	hybrid/overlay sph/rhosum/multiphase 1 sph/taitwater/multiphase
pair_coeff	1 1 sph/rhosum/multiphase ${cutoff}
pair_coeff	1 1 sph/taitwater/multiphase ${rho0} ${csound} ${nu} ${gamma} ${cutoff} 0
fix	        1 all nve
neighbor	5.0 bin
neigh_modify    delay 0 every 1
timestep        0.0001

dump mdump all custom 1 dump.dpd.* id type x y vx vy c_rhoatom
run 0
variable f1 equal fx[1]
variable f2 equal fy[1]
variable rho equal v_rhoat[1]
print "f: ${f1} ${f2}"

run 1
